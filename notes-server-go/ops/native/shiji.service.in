# Managed by art-shier/notes native installer
[Unit]
Description=Shiji Notes Go and Web
Wants=network-online.target
Requires=@SERVICE@-config.service
After=network-online.target @SERVICE@-config.service

[Service]
Type=simple
User=@SERVICE@
Group=@SERVICE@
WorkingDirectory=@DATA@
EnvironmentFile=@CONFIG@/service.env
Environment=REQUIRE_DATABASE_URL=true
ExecStartPre=@INSTALL@/current/shiji migrate
ExecStart=@INSTALL@/current/shiji serve
Restart=on-failure
RestartSec=5
TimeoutStartSec=180
TimeoutStopSec=40
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=@DATA@
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
